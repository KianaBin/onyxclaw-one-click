# Kubernetes target
KUBE_CONTEXT=<target-context>
KUBECONFIG=/absolute/path/to/cce-kubeconfig.yaml
NAMESPACE=<target-namespace>
REGION=<target-region>

# Shared public release artifact. Keep the digest to make deployments repeatable.
APP_IMAGE=swr.cn-south-1.myhuaweicloud.com/demo-test/onyxclaw-app:0.3.8-session-routing-debug-nodelay-wait5s-v19@sha256:fe0c5274fff79897fce53634756694edc9799f393e3e3dde416d604749788293
IMAGE_PULL_SECRET=
REPLICAS=1

# AgentSphere E2B-compatible control plane and the private data-plane URL of an
# Agent Gateway that has private access enabled and shares the Template VPC.
# AgentSphere E2B-compatible control plane for cn-south-1. Do not use a
# sandbox-service host or prepend api.; those names do not resolve.
AGENTSPHERE_API_URL=https://agentsphere.cn-south-1.myhuaweicloud.com
AGENTSPHERE_SANDBOX_URL=<agentsphere-sandbox-data-plane-url>
# Copy the public release artifact to the target tenant SWR before creating the Template.
# Keep the known stable digest while replacing the registry organization.
AGENTSPHERE_TEMPLATE_IMAGE=swr.cn-south-1.myhuaweicloud.com/<target-org>/onyxclaw-openclaw:0.3.8-channel-error-fix@sha256:d29c37290298d374dd6438ae92ee2def3dadf9e1f7599704f341483c302442b5
AGENTSPHERE_TEMPLATE_ID=<agentsphere-template-id>
# Set true only after manually creating the Template in the AgentSphere console.
AGENTSPHERE_TEMPLATE_READY=false

# APP traffic and AgentSphere Channel traffic can use different exposure paths.
# NodePort matches the demo topology; a production deployment can use a second
# private/public ELB by changing APP_SERVICE_TYPE and its annotations.
APP_SERVICE_TYPE=NodePort
APP_SERVICE_ANNOTATIONS_JSON={}
APP_SERVICE_PORT=3000
APP_NODE_PORT=30080
APP_PUBLIC_URL=

# Recommended for a new account: let CCE create a private shared ELB and manage
# its TCP 18890 listener and Service backends. No ELB needs to be created first.
# Existing-ELB alternative:
# {"kubernetes.io/elb.id":"<private-elb-id>","kubernetes.io/elb.class":"union"}
CHANNEL_SERVICE_TYPE=LoadBalancer
CHANNEL_SERVICE_NAME=onyxclaw-channel-lb
CHANNEL_SERVICE_ANNOTATIONS_JSON={"kubernetes.io/elb.class":"union","kubernetes.io/elb.autocreate":"{\"type\":\"inner\",\"name\":\"onyxclaw-channel\"}"}
CHANNEL_SERVICE_PORT=18890
CHANNEL_PUBLIC_URL=auto

# These values must match openclaw-base-config.json.
MODEL_PROVIDER=deepseek
MODEL_ID=deepseek-v4-flash
OPENCLAW_BASE_CONFIG_FILE=./openclaw-base-config.json

# SFS Turbo and AgentSphere pause/resume are the required deployment profile.
SANDBOX_ON_TIMEOUT=pause
CLEANUP_POLICY=kill
PAUSE_RESUME=true
MEMORY_PERSISTENCE=true
SFS_TURBO_ID=<sfs-turbo-id>
SFS_SHARE_PATH=/onyxclaw/workspace
SFS_MOUNT_DIR=/home/node/.openclaw/workspace

# Optional Pod sizing.
CPU_REQUEST=100m
MEMORY_REQUEST=128Mi
CPU_LIMIT=1
MEMORY_LIMIT=1Gi
