# 只需填写这四项。其余部署参数均使用已验证的广州 Demo/Test 固定值。
# 从 CCE 控制台下载的 kubeconfig 绝对路径。
KUBECONFIG=/absolute/path/to/cce-kubeconfig.yaml
# 开启私网访问的智能体网关“私网数据面地址”。
AGENTSPHERE_SANDBOX_URL=<agentsphere-sandbox-data-plane-url>
# 在同一 VPC 中创建 OpenClaw Template 后得到的 Template ID。
AGENTSPHERE_TEMPLATE_ID=<agentsphere-template-id>
# SFS Turbo 文件系统 ID；workspace 路径由部署器固定。
SFS_TURBO_ID=<sfs-turbo-id>

# 可选：kubeconfig 中有多个 context 时，明确指定本次目标；通常不需要填写。
# KUBE_CONTEXT=<target-context>
# 可选：默认创建 namespace onyxclaw。
# NAMESPACE=onyxclaw
# 可选：默认 nodeport，通过节点公网 EIP 的 30080 端口访问 APP。
# 若节点无法绑定 EIP，设置 public-elb；CCE 将创建公网 ELB 并申请、绑定专用 EIP，浏览器访问部署输出的 APP URL。
# 首次部署前确定，已有 APP Service 不可原地切换此模式。
# APP_ACCESS_MODE=public-elb
