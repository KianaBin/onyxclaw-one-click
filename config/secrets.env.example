# scripts/init.sh copies this file to config/secrets.env, restricts it to mode 600, and never commits it.
AGENTSPHERE_E2B_API_KEY=<agentsphere-e2b-api-key>
# Obtain this key from the target model provider yourself; for DeepSeek, use its own API Key.
MODEL_API_KEY=<target-model-api-key>
# Required to be non-empty, but no user-provided secret is needed for this demo.
CHANNEL_SIGNING_SECRET=placeholder
# The APP replaces this value during runtime bootstrap; keep any non-empty placeholder.
OPENCLAW_GATEWAY_TOKEN=placeholder
